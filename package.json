{
  "name": "pixelrunner-shared",
  "version": "0.0.1",
  "description": "",
  "private": true,
  "license": "SEE LICENSE IN LICENSE",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
     "./lib/*": "./dist/lib/*",
     "./backend": {
       "types": "./dist/index.backend-only.d.ts",
       "import": "./dist/index.backend-only.js"
     }
  },
  "author": "Pixelrunner",
  "homepage": "https://pixelrunner.dev",
  "audit-level": "moderate",
  "bin": {
    "remote-push": "./scripts/remote-push.sh",
    "remote-npm": "./scripts/remote-npm.sh",
    "remote-poweroff": "./scripts/remote-poweroff.sh",
    "remote-reboot": "./scripts/remote-reboot.sh"
  },
  "bugs": {
    "url": "https://github.com/pixelrunner/pixelrunner-controller/issues"
  },
  "config": {
    "project_name": "shared",
    "remote_user": "root",
    "remote_pass": "pixelrunner",
    "remote_host": "192.168.5.178",
    "remote_dir": "/home/pixelrunner/pixelrunner26/shared"
  },
  "funding": "http://pixelrunner.dev/donate",
  "engines": {
    "node": ">=24.0.0"
  },
  "keywords": [
    "Pixelrunner",
    "led",
    "matrix",
    "screen",
    "display",
    "iot",
    "raspberry",
    "pi",
    "Noderunners"
  ],
  "overrides": {
    "esbuild": "^0.28.1"
  },
  "scripts": {
    "prepare": "npm run build",
    "prepack": "npm run build",
    "build": "tsc && cp -r lib/interfaces dist/lib/ && cp -r lib/types.d.ts dist/lib",
    "clean": "rm -rf dist",
    "type-check": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest",
    "test:coverage": "vitest --coverage",
    "test:ci": "vitest run --coverage",
    "ci": "npm audit && npm run type-check && npm run test:ci",
    "remote:npm-install": "npx remote-npm install",
    "remote:push": "npx remote-push",
    "remote:poweroff": "npx remote-poweroff",
    "remote:reboot": "npx remote-reboot"
  },
  "dependencies": {
    "globals": "^17.6.0",
    "winston": "^3.19.0"
  },
  "peerDependencies": {
    "ws": "^8.21.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tsconfig/node24": "^24.0.4",
    "@types/node": "^24.13.0",
    "@vitest/coverage-v8": "^4.1.8",
    "eslint": "^10.4.1",
    "jiti": "^2.3.0",
    "tsx": "^4.22.4",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.60.1",
    "vitest": "^4.1.8",
    "ws": "^8.21.0"
  }
}
